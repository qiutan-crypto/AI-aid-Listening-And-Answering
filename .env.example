# 复制这个文件为 .env，然后填上你的 Key

# Deepgram：把英文语音转成文字（https://console.deepgram.com/）
DEEPGRAM_API_KEY=

# Gemini：根据对话生成回答提示（https://aistudio.google.com/apikey）
GEMINI_API_KEY=

# 可选：Gemini 模型，默认用最新的 flash（速度快）
# GEMINI_MODEL=gemini-flash-latest
# 可选：通话中 Gemini 的思考深度 minimal / low / medium / high，越低越快；off = 不设置
# GEMINI_THINKING=minimal

# 可选：不用 Gemini、改用 Claude 时填这个（GEMINI_API_KEY 留空）
# ANTHROPIC_API_KEY=
# HINT_MODEL=claude-opus-5
# HINT_EFFORT=low

# 可选：端口
# PORT=3000
