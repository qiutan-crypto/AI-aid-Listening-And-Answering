# 复制这个文件为 .env，然后填上你的 Key

# 必填：Claude API Key（https://console.anthropic.com/ 申请）
ANTHROPIC_API_KEY=

# 可选：Deepgram 语音识别 Key（https://console.deepgram.com/ 申请，新用户有免费额度）
# 填了才能「听电脑里的声音」（Zoom / Teams / 网页电话），识别也更准
DEEPGRAM_API_KEY=

# 可选：AI 提示用的模型和思考深度（low 最快；medium / high 更细致但更慢）
# HINT_MODEL=claude-opus-5
# HINT_EFFORT=low

# 可选：端口
# PORT=3000
